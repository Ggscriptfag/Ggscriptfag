--// GGSCRIPTFAG HOT POTATO - SERVER
--// Secure multiplayer authority
local Players=game:GetService("Players")
local ReplicatedStorage=game:GetService("ReplicatedStorage")
local TweenService=game:GetService("TweenService")
local remote=ReplicatedStorage:WaitForChild("Ggscriptfag_HotPotato_Remote")
local bombOwner=nil
local dangerBillboard=nil
local roundActive=false
local roundNumber=0
local timer=30
local eliminated={}
local config={Timer=30,PassDistance=18,DoubleBomb=false,TripleBomb=false,RandomTimer=true,Abilities=true,AutoPass=false,Chaos=false,Explosions=true,Hazards=true,Cinematic=true,ScreenShake=true,DynamicMusic=true,SafeZone=false,SpeedRound=false,LowGravity=false}
local stats={}
local function getStats(player)
	stats[player.UserId]=stats[player.UserId]or{Wins=0,Losses=0,Passes=0,Bombs=0,XP=0,Streak=0,MVP=0,Survival=0,Achievements=0}
	return stats[player.UserId]
end
local function removeDanger()
	if dangerBillboard then
		dangerBillboard:Destroy()
		dangerBillboard=nil
	end
end
local function addDanger(player)
	removeDanger()
	if not player.Character then return end
	local head=player.Character:FindFirstChild("Head")
	if not head then return end
	local gui=Instance.new("BillboardGui")
	gui.Name="HotPotatoDanger"
	gui.Adornee=head
	gui.Size=UDim2.fromOffset(240,70)
	gui.StudsOffset=Vector3.new(0,3.5,0)
	gui.AlwaysOnTop=true
	gui.MaxDistance=200
	gui.Parent=head
	local frame=Instance.new("Frame")
	frame.Size=UDim2.fromScale(1,1)
	frame.BackgroundColor3=Color3.fromRGB(35,0,0)
	frame.BackgroundTransparency=.08
	frame.BorderSizePixel=0
	frame.Parent=gui
	local corner=Instance.new("UICorner")
	corner.CornerRadius=UDim.new(0,16)
	corner.Parent=frame
	local stroke=Instance.new("UIStroke")
	stroke.Color=Color3.fromRGB(255,40,40)
	stroke.Thickness=3
	stroke.Parent=frame
	local label=Instance.new("TextLabel")
	label.Size=UDim2.fromScale(1,1)
	label.BackgroundTransparency=1
	label.Text="⚠️ DANGER"
	label.TextColor3=Color3.fromRGB(255,65,65)
	label.TextScaled=true
	label.Font=Enum.Font.GothamBlack
	label.Parent=frame
	dangerBillboard=gui
end
local function removeBombs(player)
	if not player then return end
	local containers={player:FindFirstChild("Backpack"),player.Character}
	for _,container in ipairs(containers)do
		if container then
			for _,item in ipairs(container:GetChildren())do
				if item:IsA("Tool")and item.Name:sub(1,10)=="HOT POTATO"then
					item:Destroy()
				end
			end
		end
	end
end
local function createBomb(player,index)
	local tool=Instance.new("Tool")
	tool.Name="HOT POTATO "..tostring(index or 1)
	tool.RequiresHandle=true
	tool.CanBeDropped=false
	tool.ToolTip="⚠️ HOT POTATO"
	tool.Parent=player:WaitForChild("Backpack")
	local handle=Instance.new("Part")
	handle.Name="Handle"
	handle.Shape=Enum.PartType.Ball
	handle.Size=Vector3.new(2,2,2)
	handle.Material=Enum.Material.Neon
	handle.Color=Color3.fromRGB(255,30,30)
	handle.CanCollide=false
	handle.Massless=true
	handle.Parent=tool
	local light=Instance.new("PointLight")
	light.Color=Color3.fromRGB(255,0,0)
	light.Brightness=8
	light.Range=18
	light.Parent=handle
	local attachment=Instance.new("Attachment")
	attachment.Parent=handle
	local particles=Instance.new("ParticleEmitter")
	particles.Rate=20
	particles.Lifetime=NumberRange.new(.2,.7)
	particles.Speed=NumberRange.new(2,5)
	particles.Size=NumberSequence.new(.18)
	particles.LightEmission=1
	particles.Parent=attachment
	local gui=Instance.new("BillboardGui")
	gui.Size=UDim2.fromOffset(100,45)
	gui.StudsOffset=Vector3.new(0,2,0)
	gui.AlwaysOnTop=true
	gui.Parent=handle
	local text=Instance.new("TextLabel")
	text.Size=UDim2.fromScale(1,1)
	text.BackgroundTransparency=1
	text.Text="💣"
	text.TextScaled=true
	text.Parent=gui
	local beep=Instance.new("Sound")
	beep.SoundId="rbxassetid://9118823103"
	beep.Volume=.5
	beep.Looped=true
	beep.Parent=handle
	beep:Play()
end
local function giveBomb(player,count)
	if not player then return end
	if bombOwner then
		removeBombs(bombOwner)
	end
	removeDanger()
	removeBombs(player)
	bombOwner=player
	getStats(player).Bombs+=1
	local amount=count or 1
	if config.TripleBomb then amount=3 elseif config.DoubleBomb then amount=2 end
	for i=1,amount do createBomb(player,i)end
	addDanger(player)
	timer=config.RandomTimer and math.random(15,45)or config.Timer
	remote:FireAllClients("BOMB_GIVEN",player.Name,timer,roundNumber)
end
local function findPlayer(name)
	if typeof(name)~="string"then return nil end
	name=name:gsub("^%s+",""):gsub("%s+$",""):lower()
	if name==""then return nil end
	for _,player in ipairs(Players:GetPlayers())do
		if player.Name:lower()==name or player.DisplayName:lower()==name then return player end
	end
	for _,player in ipairs(Players:GetPlayers())do
		if player.Name:lower():sub(1,#name)==name or player.DisplayName:lower():sub(1,#name)==name then return player end
	end
end
local function getNearest(player)
	if not player or not player.Character then return nil end
	local root=player.Character:FindFirstChild("HumanoidRootPart")
	if not root then return nil end
	local closest=nil
	local distance=config.PassDistance
	for _,target in ipairs(Players:GetPlayers())do
		if target~=player and target.Character and target.Character:FindFirstChild("HumanoidRootPart")and not eliminated[target.UserId]then
			local d=(target.Character.HumanoidRootPart.Position-root.Position).Magnitude
			if d<distance then
				distance=d
				closest=target
			end
		end
	end
	return closest
end
local function passBomb(target)
	if not bombOwner or not target or target==bombOwner then return end
	local old=bombOwner
	getStats(old).Passes+=1
	giveBomb(target)
	remote:FireAllClients("PASS",old.Name,target.Name)
end
local function alivePlayers()
	local list={}
	for _,player in ipairs(Players:GetPlayers())do
		if not eliminated[player.UserId]then
			table.insert(list,player)
		end
	end
	return list
end
local function startRound()
	local players=alivePlayers()
	if #players<1 then return end
	eliminated={}
	roundActive=true
	roundNumber+=1
	timer=config.RandomTimer and math.random(15,45)or config.Timer
	local selected=players[math.random(1,#players)]
	giveBomb(selected)
	remote:FireAllClients("ROUND_START",roundNumber)
end
local function endRound()
	local players=alivePlayers()
	roundActive=false
	if #players==1 then
		local winner=players[1]
		local data=getStats(winner)
		data.Wins+=1
		data.Streak+=1
		data.XP+=100
		data.MVP+=1
		remote:FireAllClients("WINNER",winner.Name)
	elseif #players==0 then
		remote:FireAllClients("WINNER","Nobody")
	end
	if bombOwner then removeBombs(bombOwner)end
	removeDanger()
	bombOwner=nil
end
remote.OnServerEvent:Connect(function(player,action,data)
	if action=="GIVE_BOMB"then
		local target=findPlayer(data)
		if target then
			giveBomb(target)
			remote:FireClient(player,"SUCCESS","Bomb given to "..target.Name)
		else
			remote:FireClient(player,"ERROR","Player not found")
		end
	elseif action=="PASS"then
		local target=findPlayer(data)or getNearest(bombOwner)
		passBomb(target)
	elseif action=="START"then
		startRound()
	elseif action=="REMOVE"then
		if bombOwner then removeBombs(bombOwner)end
		removeDanger()
		bombOwner=nil
	elseif action=="ABILITY"and config.Abilities then
		local character=player.Character
		local humanoid=character and character:FindFirstChildOfClass("Humanoid")
		local root=character and character:FindFirstChild("HumanoidRootPart")
		if data=="SPEED"and humanoid then
			humanoid.WalkSpeed=60
			task.delay(5,function()if humanoid and humanoid.Parent then humanoid.WalkSpeed=16 end end)
		elseif data=="JUMP"and humanoid then
			humanoid.JumpPower=100
			task.delay(5,function()if humanoid and humanoid.Parent then humanoid.JumpPower=50 end end)
		elseif data=="DASH"and root then
			root.AssemblyLinearVelocity=root.CFrame.LookVector*120
		elseif data=="TELEPORT"and root then
			local target=getNearest(player)
			if target and target.Character and target.Character:FindFirstChild("HumanoidRootPart")then
				root.CFrame=target.Character.HumanoidRootPart.CFrame*CFrame.new(0,0,-5)
			end
		elseif data=="FREEZE"then
			local target=getNearest(player)
			local h=target and target.Character and target.Character:FindFirstChildOfClass("Humanoid")
			if h then
				h.WalkSpeed=0
				task.delay(3,function()if h and h.Parent then h.WalkSpeed=16 end end)
			end
		elseif data=="STEAL"then
			passBomb(getNearest(player))
		end
	end
end)
Players.PlayerAdded:Connect(function(player)
	getStats(player)
	player.CharacterAdded:Connect(function()
		task.wait(1)
		if bombOwner==player then addDanger(player)end
	end)
end)
Players.PlayerRemoving:Connect(function(player)
	if bombOwner==player then
		removeDanger()
		bombOwner=nil
		local players=alivePlayers()
		if #players>0 and roundActive then
			giveBomb(players[math.random(1,#players)])
		end
	end
end)
task.spawn(function()
	while true do
		task.wait(1)
		if roundActive and bombOwner then
			timer-=1
			remote:FireAllClients("TIMER",timer)
			if timer<=10 then
				remote:FireAllClients("WARNING",timer)
			end
			if timer<=0 then
				local old=bombOwner
				eliminated[old.UserId]=true
				getStats(old).Losses+=1
				getStats(old).Streak=0
				removeBombs(old)
				removeDanger()
				bombOwner=nil
				remote:FireAllClients("ELIMINATED",old.Name)
				local players=alivePlayers()
				if #players<=1 then
					endRound()
				else
					task.wait(2)
					giveBomb(players[math.random(1,#players)])
				end
			end
		end
	end
end)
